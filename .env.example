# ============================================
# YouTube Automation - Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- LLM Provider (choose one: bytez, groq, ollama, gemini) ----
LLM_PROVIDER=bytez

# ---- Bytez (125+ models, cloud API) ----
# Get your API key at: https://bytez.com/api
BYTEZ_API_KEY=your_bytez_api_key_here
BYTEZ_MODEL=Qwen/Qwen3-4B

# ---- Groq (FREE, ultra-fast cloud LLM) ----
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama (local fallback) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ---- Google Gemini (free tier) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- YouTube Upload ----
YOUTUBE_CLIENT_SECRET_FILE=Client_secret.json

# ---- Video Settings ----
VIDEO_DURATION_MIN=30
VIDEO_DURATION_MAX=300
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=24

# ---- Voice Settings ----
NARRATOR_VOICE=en-US-GuyNeural
CHARACTER_VOICE_MALE=en-US-ChristopherNeural
CHARACTER_VOICE_FEMALE=en-US-JennyNeural

# ---- Upload Settings ----
YOUTUBE_CATEGORY=24
MADE_FOR_KIDS=false
PLAYLIST_ID=
SCHEDULE_TIME=

# ---- Scheduler Settings ----
DAILY_VIDEO_COUNT=4
SCHEDULE_START_HOUR=5
SCHEDULE_END_HOUR=23

# Email Trigger (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
